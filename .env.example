# ── API URL ───────────────────────────────────────────────────────────────────
# Production server (EC2 / VPS)
# EXPO_PUBLIC_API_URL=http://your-server-ip-or-domain:3000/api

# Local development (replace with your machine's LAN IP)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api

# ── PartyKit ──────────────────────────────────────────────────────────────────
# Same host as in backend .env (after running: npx partykit deploy)
# Local: ws://192.168.x.x:1999 | Production: wss://pizzaazez-party.your-username.partykit.dev
EXPO_PUBLIC_PARTYKIT_WS_URL=ws://192.168.x.x:1999
