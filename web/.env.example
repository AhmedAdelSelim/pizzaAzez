# ── API URL ───────────────────────────────────────────────────────────────────
# Production server (EC2 / VPS)
# NEXT_PUBLIC_API_URL=https://your-server-or-domain/api

# Local development
NEXT_PUBLIC_API_URL=http://localhost:3000/api


# ── Admin ─────────────────────────────────────────────────────────────────────
# Must match ADMIN_PHONE in the backend .env, or the story composer will not
# recognise the master admin.
NEXT_PUBLIC_ADMIN_PHONE=01021317616


# ── Supabase Storage (profile + story image uploads) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://utotcozlqmnverrugjkx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_HSLL7fsrq4wOZVvxH2lT4Q_XFYKcemz


# ── Tests only (web/.env.local, gitignored) ───────────────────────────────────
# The Playwright suite creates and deletes real rows, so it talks to Supabase
# directly and needs the SECRET (service_role) key — RLS denies the publishable
# one. It also needs an admin account to log in as. There are deliberately no
# defaults for these: inline ones once put working admin credentials in a public
# repository.
#
# TEST_SUPABASE_URL=https://your-project.supabase.co
# TEST_SUPABASE_KEY=your-supabase-service-role-key
# TEST_ADMIN_PHONE=01xxxxxxxxx
# TEST_ADMIN_PASSWORD=the-admin-password
