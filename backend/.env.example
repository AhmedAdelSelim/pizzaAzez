# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Number of cluster workers to fork (defaults to CPU count if not set)
WEB_CONCURRENCY=4

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret

# ── Admin ─────────────────────────────────────────────────────────────────────
# Phone number that is automatically granted the admin role on login
ADMIN_PHONE=01021317616


# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
