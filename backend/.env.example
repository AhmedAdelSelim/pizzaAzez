# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Number of cluster workers to fork (defaults to CPU count if not set)
WEB_CONCURRENCY=4

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# The SECRET (service_role) key, not the publishable one. Row Level Security is
# on (migrations/004_enable_rls.sql) and the publishable key is denied every
# table — the API is the trusted server and needs the key that bypasses RLS.
# Never put this in a client bundle or a NEXT_PUBLIC_* variable.
SUPABASE_KEY=your-supabase-service-role-key

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The server refuses to start in production on anything shorter than 32
# characters, or on a value that has previously been published.
JWT_SECRET=change-me-to-a-long-random-secret

# ── Admin ─────────────────────────────────────────────────────────────────────
# Phone number that is automatically granted the admin role on login
ADMIN_PHONE=01021317616


# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
